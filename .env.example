# Gemini
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Moteur de recherce
SEARCH_PROVIDER=tavily

#Tavily API key
TAVILY_API_KEY=your_api_key_here

# Database
DATABASE_URL=sqlite:///data/icp.db

# LLM
LLM_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=

# Enrichment engine: "bs4" (default, legacy requests+BeautifulSoup, one
# profile at a time) or "scrapy" (batch crawl, one Scrapy run per workflow
# via a dedicated subprocess). See MIGRATION.md, partie B.
ENRICHMENT_ENGINE=bs4

#Découpage en sous-lots pour la qualification
GEMINI_BATCH_SIZE=5

# Minimum delay (seconds) between two workflow runs from the Streamlit UI,
# and the maximum number of runs allowed per browser session.
WORKFLOW_COOLDOWN_SECONDS=30
MAX_WORKFLOW_RUNS_PER_SESSION=20


