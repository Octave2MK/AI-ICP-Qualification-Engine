# WARNING: limiter and botdetection are disabled below for local development
# convenience. This is only safe as long as the SearXNG host port stays bound
# to 127.0.0.1 (the default in docker/docker-compose.yml). Re-enable both
# before exposing this instance beyond localhost.
use_default_settings: false

outgoing:
  extra_proxy_timeout: 10
  proxies:
    all://:
      - socks5h://tor:9050

server:
  # Replace this value before starting SearXNG.
  secret_key: "CHANGE_ME_TO_A_RANDOM_SECRET"
  bind_address: "0.0.0.0"
  limiter: false

search:
  safe_search: 0
  formats:
    - html
    - json

ui:
  static_use_hash: true

botdetection:
  enabled: false

enabled_plugins:
  - Hash plugin

engines:
  - name: duckduckgo
    disabled: false

  - name: bing
    disabled: false

  - name: qwant
    disabled: false

  - name: mojeek
    disabled: false

  - name: brave
    disabled: false

  - name: startpage
    disabled: true

  - name: wikidata
    disabled: true
